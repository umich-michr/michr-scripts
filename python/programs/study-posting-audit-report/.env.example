# =============================================================================
# study-posting-audit-report local configuration example
#
# Setup:
#
#   cp \
#     python/programs/study-posting-audit-report/.env.example \
#     python/programs/study-posting-audit-report/.env
#
#   chmod 600 python/programs/study-posting-audit-report/.env
#
# The copied .env file is local and must not be committed. This .env.example
# file contains no real credentials, hostnames, identifiers, or audit data.
#
# Resolution precedence:
#
#   command line
#   -> process environment
#   -> this .env file
#   -> program default
#   -> interactive prompt
#   -> missing-setting error
#
# Blank values are generally treated as unresolved. Do not place quotes around
# values unless the quotes are part of normal dotenv syntax.
#
# Variable interpolation is disabled. A value such as ${OTHER_VARIABLE} remains
# literal text and is not expanded.
# =============================================================================


# =============================================================================
# Minimal CSV configuration
#
# This is the only required CSV-specific setting when the default schema and
# output directory are appropriate.
# =============================================================================

# Absolute paths are recommended. A relative path is resolved from the process
# working directory, normally the repository root.
# STUDY_POSTING_AUDIT_CSV_INPUT=/absolute/protected/path/audit-export.csv


# =============================================================================
# Minimal Oracle configuration
#
# Set these three values to run:
#
#   uv run study-posting-audit-report database
#
# The password has no command-line option. Keep it only in the process
# environment, this ignored .env file, or the non-echoing interactive prompt.
# =============================================================================

# Easy Connect example:
# STUDY_POSTING_AUDIT_DB_DSN=host.example:1521/service_name

# A locally resolvable TNS alias may be used instead:
# STUDY_POSTING_AUDIT_DB_DSN=REPORTING_DATABASE

# STUDY_POSTING_AUDIT_DB_USERNAME=reporting_user
# STUDY_POSTING_AUDIT_DB_PASSWORD=replace-with-local-password


# =============================================================================
# Shared settings
# =============================================================================

# Canonical row schema.
# Default:
# python/programs/study-posting-audit-report/input/audit-schema.json
#
# STUDY_POSTING_AUDIT_SCHEMA=python/programs/study-posting-audit-report/input/audit-schema.json

# New output directory. It must not already exist.
# Default:
# output/study-posting-ai-audit-analysis/report
#
# STUDY_POSTING_AUDIT_OUTPUT=output/study-posting-ai-audit-analysis/report

# Populate selected_text and final_text in ai_assistance_metrics.csv.
# This does not remove source payloads from records.csv.
# Accepted Boolean text: true, false, 1, 0, yes, no, on, off
# Default: false
#
# STUDY_POSTING_AUDIT_INCLUDE_TEXT=false

# Permit interactive prompts for unresolved settings.
# Default: true
#
# STUDY_POSTING_AUDIT_PROMPT=true


# =============================================================================
# CSV settings
# =============================================================================

# Input encoding.
# Default: utf-8-sig
#
# STUDY_POSTING_AUDIT_CSV_ENCODING=utf-8-sig

# Exactly one delimiter character.
# Default: comma
#
# STUDY_POSTING_AUDIT_CSV_DELIMITER=,

# Exactly one quote character.
# Default: double quote
#
# STUDY_POSTING_AUDIT_CSV_QUOTECHAR="

# Optional single escape character.
# Default: none
#
# Example for a backslash:
# STUDY_POSTING_AUDIT_CSV_ESCAPECHAR=\

# JSON array of exact CSV field values interpreted as null.
# Default: empty field and \N
#
# STUDY_POSTING_AUDIT_CSV_NULL_VALUES=["","\\N"]


# =============================================================================
# Database settings
# =============================================================================

# Database driver.
# Currently supported: oracle
# Default: oracle
#
# STUDY_POSTING_AUDIT_DB_DRIVER=oracle

# Number of rows requested per fetchmany() call.
# Default: 500
#
# STUDY_POSTING_AUDIT_DB_FETCH_SIZE=500

# Operational SQL file.
# Default:
# python/programs/study-posting-audit-report/input/audit-rows.sql
#
# Copy audit-rows.example.sql to this ignored path and customize it locally.
#
# STUDY_POSTING_AUDIT_SQL_FILE=python/programs/study-posting-audit-report/input/audit-rows.sql

# SQL bind parameters as a JSON object.
# Default: {}
#
# Values retain their JSON types.
#
# STUDY_POSTING_AUDIT_SQL_PARAMS={"start_time":"2026-01-01","limit":100}


# =============================================================================
# Dotenv path override
#
# STUDY_POSTING_AUDIT_ENV_FILE is read only from the process environment because
# the dotenv path must be resolved before a dotenv file can be loaded.
#
# Example:
#
#   export STUDY_POSTING_AUDIT_ENV_FILE=/absolute/path/settings.env
# =============================================================================
