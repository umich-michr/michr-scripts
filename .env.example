# ---------------------------------------------------------------------------
# Copy this file to .env and fill in local values.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# All variables use the STUDY_POSTING_ prefix to avoid collisions.
# ---------------------------------------------------------------------------

# Which data source the CLI should read from: "sqlite" or "oracle".
STUDY_POSTING_SOURCE=sqlite

# --- SQLite (local development and testing) --------------------------------
# Path to the local SQLite database built from a CSV export.
STUDY_POSTING_SQLITE_PATH=data/local_audit_records.db

# --- Oracle (python-oracledb thin mode; no Instant Client needed) ----------
# Easy Connect syntax: host:port/service_name
STUDY_POSTING_ORACLE_DSN=oracle-host.example.umich.edu:1521/SERVICE_NAME
STUDY_POSTING_ORACLE_USER=
STUDY_POSTING_ORACLE_PASSWORD=

# Fully qualified table or view holding the audit rows.
STUDY_POSTING_ORACLE_TABLE=AUDIT_RECORDS

# Rows fetched per network round trip. Larger values reduce round trips but
# increase memory use. 500 is a reasonable default for wide rows containing
# large JSON payloads.
STUDY_POSTING_ORACLE_ARRAY_SIZE=500

# --- Output ----------------------------------------------------------------
# Directory for generated CSV files. Cleared by "make clean".
STUDY_POSTING_OUTPUT_DIR=output

# --- Logging ---------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
STUDY_POSTING_LOG_LEVEL=INFO

# Set to "true" to include selected and final free text in exported CSV files.
# Default is false to reduce accidental disclosure of sensitive text.
STUDY_POSTING_INCLUDE_TEXT=false
