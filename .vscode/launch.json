{
  // =======================================================================
  // Debug configurations
  //
  // This library has no command-line interface, so the configurations below
  // debug tests and scratch files.
  //
  // justMyCode is false for tests so you can step into rapidfuzz or
  // sacrebleu when verifying a metric result.
  // =======================================================================
  "version": "0.2.0",

  "configurations": [
    {
      "name": "Tests: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-p", "no:randomly", "-vv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Tests: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-p", "no:randomly", "-vv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Tests: by keyword (prompts)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-p",
        "no:randomly",
        "-vv",
        "-k",
        "${input:testKeyword}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Tests: fast only",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-p", "no:randomly", "-m", "not slow", "-vv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ],

  "inputs": [
    {
      "id": "testKeyword",
      "type": "promptString",
      "description": "pytest -k expression",
      "default": "soft_word"
    }
  ]
}
